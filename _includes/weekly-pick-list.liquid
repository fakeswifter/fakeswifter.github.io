{% assign issue = include.issue %}
{% assign categories = "book,film,music" | split: "," %}
<div class="picks-list">
  {% if issue.picks %}
    {% for item in issue.picks %}
      {% assign item_cover = item.cover %}
      {% unless item.cover contains '://' %}{% assign item_cover = item.cover | relative_url %}{% endunless %}
      <article class="picks-row">
        <p class="picks-category">{{ item.category | default: "Pick" | escape }}</p>
        {% if item.cover %}
          <img class="picks-cover" src="{{ item_cover | escape }}" alt="{{ item.title | escape }} 配图" loading="lazy" decoding="async"{% if item.fallback %} onerror="this.onerror=null;this.src='{{ item.fallback | relative_url | escape }}'"{% endif %}>
        {% else %}
          <div class="picks-cover-empty" aria-hidden="true"></div>
        {% endif %}
        <h3 class="picks-name">{{ item.title | escape }}</h3>
        <p class="picks-creator">{{ item.creator | default: "" | escape }}</p>
        {% if item.url %}
          <a class="picks-open" href="{{ item.url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="打开 {{ item.title | escape }} 的介绍">↗</a>
        {% else %}
          <span class="picks-open" aria-hidden="true">↗</span>
        {% endif %}
      </article>
    {% endfor %}
  {% else %}
    {% for category in categories %}
      {% assign item = issue[category] %}
      {% if item and item.title %}
        {% case category %}
          {% when "book" %}{% assign category_label = "Book" %}
          {% when "film" %}{% assign category_label = "Film" %}
          {% when "music" %}{% assign category_label = "Music" %}
        {% endcase %}
        {% assign item_cover = item.cover %}
        {% unless item.cover contains '://' %}{% assign item_cover = item.cover | relative_url %}{% endunless %}
        <article class="picks-row">
          <p class="picks-category">{{ category_label }}</p>
          {% if item.cover %}
            <img class="picks-cover" src="{{ item_cover | escape }}" alt="{{ item.title | escape }} 配图" loading="lazy" decoding="async"{% if item.fallback %} onerror="this.onerror=null;this.src='{{ item.fallback | relative_url | escape }}'"{% endif %}>
          {% else %}
            <div class="picks-cover-empty" aria-hidden="true"></div>
          {% endif %}
          <h3 class="picks-name">{{ item.title | escape }}</h3>
          <p class="picks-creator">{{ item.creator | default: "" | escape }}</p>
          {% if item.url %}
            <a class="picks-open" href="{{ item.url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="打开 {{ item.title | escape }} 的介绍">↗</a>
          {% else %}
            <span class="picks-open" aria-hidden="true">↗</span>
          {% endif %}
        </article>
      {% endif %}
    {% endfor %}
  {% endif %}
</div>
